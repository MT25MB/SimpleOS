# SimpleOS system image
# -----------------------------------------------------------------------------
# Built on uBlue's immutable/atomic base: an OCI-native Fedora Atomic image.
# Packages are layered with rpm-ostree and committed into the image so every
# build is reproducible, bootable, and upgradeable atomically.
#
# Build context is the repository root (see scripts/build-iso.sh), which is why
# the COPY sources below are relative to that directory.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Stage 1: build the launcher that the desktop session supervises.
#
# The React/Electron shell is built here so the immutable image contains a real
# kiosk application, not just a wallpaper and a supervisor waiting for a binary.
# Electron is a dev dependency in package.json, so npm ci installs it here and
# only its runtime directory is copied into the final image.
# -----------------------------------------------------------------------------
FROM node:22 AS shell-build

WORKDIR /src
COPY docs/assets/ /docs/assets/
COPY simpleos-shell/package.json simpleos-shell/package-lock.json ./
RUN npm ci
# npm's optional postinstall can be skipped in some environments. Fail the
# build here if the Electron binary was not downloaded: a kiosk without it
# would boot to a bare wallpaper.
RUN node node_modules/electron/install.js \
    && test -x node_modules/electron/dist/electron
COPY simpleos-shell/ ./
RUN npm run build

# -----------------------------------------------------------------------------
# Stage 2: the bootable SimpleOS system.
# -----------------------------------------------------------------------------

FROM ghcr.io/ublue-os/base-main:latest

LABEL org.opencontainers.image.title="SimpleOS" \
      org.opencontainers.image.description="A calm, accessible, immutable Linux desktop" \
      org.opencontainers.image.licenses="MIT"

# UTC is the default timezone for the whole system.
ENV TZ=UTC

# Desktop stack, display manager, accessibility, printing, apps, and readable
# fonts. Fedora package names are used (rsms-inter-fonts = Inter;
# google-noto-sans-fonts = Noto Sans).
#
# The hardware group makes this a usable image on ordinary Intel/AMD laptops
# and desktops: firmware and Mesa drivers for Wi-Fi/Graphics, NetworkManager
# and Bluez for connections, power-profiles-daemon and upower for laptops,
# brightnessctl for the brightness buttons, and pulseaudio-utils for the
# `pactl` volume commands used by the allowlisted shell bridge.
#
# foot is installed for caregiver/recovery use but is hidden from the user's
# application menus further down this file.
# BuildKit cache mounts keep repeated local builds fast (pattern from uBlue's
# Containerfile). /tmp is a tmpfs so no package scratch files enter the image.
# The explicit greetd links below matter: graphical.target pulls
# display-manager.service, and without these links the image boots to a text
# console instead of the kiosk session.
RUN --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    rpm-ostree install --assumeyes \
        labwc \
        greetd \
        swaybg \
        foot \
        flatpak \
        pipewire \
        wireplumber \
        cups \
        system-config-printer \
        nm-connection-editor \
        orca \
        rsms-inter-fonts \
        google-noto-sans-fonts \
        adwaita-icon-theme \
        linux-firmware \
        mesa-dri-drivers \
        NetworkManager \
        bluez \
        power-profiles-daemon \
        upower \
        brightnessctl \
        pulseaudio-utils \
        gtk3 \
        nss \
        alsa-lib \
        libgbm \
        at-spi2-atk \
        libxkbcommon \
        libdrm \
        espeak-ng \
        python3 \
        python3-pip \
        unzip \
        curl \
        polkit \
        xdg-desktop-portal \
        xdg-desktop-portal-wlr \
        xdg-desktop-portal-gtk \
    && ostree container commit

# Optional offline voice features. ffmpeg comes from the base image already.
# The small Vosk model is a fixed download;
# if it is unavailable the UI reports that voice commands are not set up.
RUN mkdir -p /usr/share/simpleos \
    && python3 -m pip install --no-cache-dir --target /usr/lib/simpleos/python vosk \
    && (curl -fsSL -o /tmp/simpleos-vosk.zip \
        https://alphacephei.com/vosk/models/vosk-model-small-en-us-0.15.zip \
        && unzip -q -o /tmp/simpleos-vosk.zip -d /usr/share/simpleos \
        && mv /usr/share/simpleos/vosk-model-small-en-us-0.15 /usr/share/simpleos/vosk-model \
        && rm -f /tmp/simpleos-vosk.zip \
        || echo "Voice model download failed; voice commands will be unavailable") \
    && ostree container commit

# Audited desktop and browser configuration.
COPY system-configs/labwc/ /etc/xdg/labwc/
COPY system-configs/firefox/policies.json /etc/firefox/policies/policies.json

# greetd autologin. system-configs/greetd/config.toml contains:
#   [initial_session]
#   command = "labwc"
#   user = "senior"
# so the machine boots straight into an unprivileged Labwc session with no
# password prompt. The "greeter" fallback is only used if autologin fails.
COPY system-configs/greetd/config.toml /etc/greetd/config.toml

# First-boot setup: create "senior" (never in wheel/sudo), add Flathub, and
# install the applications shown on the launcher.
COPY system-configs/systemd/simpleos-firstboot.service /etc/systemd/system/simpleos-firstboot.service
COPY system-configs/systemd/simpleos-firstboot.sh /etc/simpleos/firstboot.sh

# Power defaults for laptops and desktops. These are systemd drop-ins, so the
# distribution defaults stay in place and only the keys we care about change.
COPY system-configs/systemd/logind.conf.d/10-simpleos-power.conf /etc/systemd/logind.conf.d/10-simpleos-power.conf
COPY system-configs/systemd/sleep.conf.d/10-simpleos-sleep.conf /etc/systemd/sleep.conf.d/10-simpleos-sleep.conf
COPY system-configs/simpleos/transcribe.py /usr/libexec/simpleos/transcribe.py
COPY system-configs/systemd/simpleos-rollback.service /etc/systemd/system/simpleos-rollback.service
COPY system-configs/systemd/simpleos-rollback.sh /usr/libexec/simpleos/rollback.sh
COPY system-configs/systemd/simpleos-update.service /etc/systemd/system/simpleos-update.service
COPY system-configs/systemd/simpleos-update.sh /usr/libexec/simpleos/update.sh
COPY system-configs/systemd/simpleos-boot-marker.service /etc/systemd/system/simpleos-boot-marker.service
COPY system-configs/systemd/simpleos-boot-marker.sh /usr/libexec/simpleos/boot-marker.sh
COPY system-configs/polkit/50-simpleos-rollback.rules /etc/polkit-1/rules.d/50-simpleos-rollback.rules
COPY system-configs/polkit/50-simpleos-update.rules /etc/polkit-1/rules.d/50-simpleos-update.rules
COPY system-configs/polkit/50-simpleos-power.rules /etc/polkit-1/rules.d/50-simpleos-power.rules

# The kiosk launcher itself. main.js resolves its renderer at ../dist from
# dist-electron, so keeping both folders together preserves that contract.
# --no-sandbox is needed because the npm-copied Electron sandbox helper is not
# SUID-root; without it Electron refuses to start as the unprivileged senior user.
COPY --from=shell-build /src/dist /usr/lib/simpleos/app/dist
COPY --from=shell-build /src/dist-electron /usr/lib/simpleos/app/dist-electron
COPY --from=shell-build /src/node_modules/electron /usr/lib/simpleos/app/node_modules/electron

# The final layer creates both greetd session users, sets the hostname and UTC
# timezone, hides foot's desktop entry, and enables the boot services. Creating
# the users here matters: greetd validates them at startup, so they must exist
# before first boot runs.
RUN (id -u senior >/dev/null 2>&1 || useradd --create-home --user-group --shell /bin/bash senior) \
    && (id -u greeter >/dev/null 2>&1 || useradd --create-home greeter) \
    && mkdir -p /usr/libexec/simpleos \
    && printf '%s\n' \
      '#!/bin/sh' \
      '# Kiosk launcher supervised by labwc/autostart.' \
      'exec /usr/lib/simpleos/app/node_modules/electron/dist/electron \' \
      '  --no-sandbox \' \
      '  --disable-gpu \' \
      '  --disable-dev-shm-usage \' \
      '  --ozone-platform=wayland \' \
      '  --use-angle=swiftshader \' \
      '  --enable-unsafe-swiftshader \' \
      '  --enable-logging=stderr --v=1 \' \
      '  /usr/lib/simpleos/app/dist-electron/main.js \' \
      '  > /tmp/simpleos-shell.log 2>&1' \
      > /usr/libexec/simpleos/simpleos-shell \
    && chmod 0755 /etc/simpleos/firstboot.sh /etc/xdg/labwc/autostart /usr/libexec/simpleos/simpleos-shell /usr/libexec/simpleos/transcribe.py /usr/libexec/simpleos/rollback.sh /usr/libexec/simpleos/update.sh /usr/libexec/simpleos/boot-marker.sh \
    && printf '%s\n' "${SIMPLEOS_VERSION:-1.4.7}" > /etc/simpleos-image-version \
    && echo "simpleos" > /etc/hostname \
    && ln -sf /usr/share/zoneinfo/UTC /etc/localtime \
    && printf 'UTC\n' > /etc/timezone \
    && mkdir -p /usr/share/applications \
    && if [ -f /usr/share/applications/foot.desktop ]; then \
        sed -i '/^NoDisplay=/d;/^Hidden=/d' /usr/share/applications/foot.desktop \
        && printf 'NoDisplay=true\nHidden=true\n' >> /usr/share/applications/foot.desktop; \
       else \
        printf '%s\n' \
          '[Desktop Entry]' \
          'Type=Application' \
          'Name=Terminal' \
          'Exec=foot' \
          'Terminal=false' \
          'NoDisplay=true' \
          'Hidden=true' \
          > /usr/share/applications/foot.desktop; \
       fi \
    && systemctl enable \
        greetd.service \
        NetworkManager.service \
        bluetooth.service \
        cups.service \
        power-profiles-daemon.service \
        upower.service \
        rpm-ostreed-automatic.timer \
        simpleos-firstboot.service \
        simpleos-boot-marker.service \
    && mkdir -p /etc/systemd/system/graphical.target.wants \
    && ln -sf /usr/lib/systemd/system/greetd.service \
        /etc/systemd/system/graphical.target.wants/greetd.service \
    && ln -sf /usr/lib/systemd/system/greetd.service \
        /etc/systemd/system/display-manager.service \
    && ln -sf /usr/lib/systemd/system/graphical.target \
        /etc/systemd/system/default.target \
    && ostree container commit

# Fail the build if the image is not a clean, bootable container (uBlue pattern).
RUN ["bootc", "container", "lint"]

# Future work (intentionally not implemented yet):
#   - generate a full disk image / ISO from this bootable container
#   - sign and verify update commits
#   - strip unused locales and drivers to reduce image size
