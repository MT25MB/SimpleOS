#!/bin/sh
# SimpleOS desktop autostart
# -----------------------------------------------------------------------------
# labwc runs this as a shell script after reading rc.xml and environment.
# Keep it quiet and predictable: a calm background and a supervised shell.
# Cursor size and text scaling are set in the sibling "environment" file.
# -----------------------------------------------------------------------------

# Calm, high-contrast solid background (dark navy). No animated wallpaper.
swaybg -c '#0B1120' >/dev/null 2>&1 &

# Keep the SimpleOS shell on screen at all times.
# The supervisor restarts the shell if it exits, so the user is never left with
# an empty desktop. Until the shell package is installed, it waits quietly and
# logs once rather than failing. Override the path with SIMPLEOS_SHELL_BIN.
SHELL_BIN="${SIMPLEOS_SHELL_BIN:-/usr/libexec/simpleos/simpleos-shell}"
(
  warned=0
  while true; do
    if [ -x "$SHELL_BIN" ]; then
      "$SHELL_BIN" || true
      warned=0
      sleep 1
    else
      if [ "$warned" -eq 0 ]; then
        logger -t simpleos "Shell not installed yet at $SHELL_BIN; waiting"
        warned=1
      fi
      sleep 10
    fi
  done
) &

# Intentionally no tray, no notification daemon, no auto-updater pop-ups.
