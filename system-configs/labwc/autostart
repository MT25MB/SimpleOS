#!/bin/sh
# SimpleOS desktop autostart
# -----------------------------------------------------------------------------
# labwc runs this as a shell script after reading rc.xml and the sibling
# "environment" file. Nothing here should ever leave the user staring at a bare
# desktop: a calm wallpaper is drawn, then the SimpleOS shell is supervised.
# -----------------------------------------------------------------------------

# Large pointer. labwc itself reads these from the "environment" file; exporting
# them here as well makes every child application use the same large cursor.
XCURSOR_THEME="${XCURSOR_THEME:-Adwaita}"
XCURSOR_SIZE="${XCURSOR_SIZE:-48}"
export XCURSOR_THEME XCURSOR_SIZE

# labwc may run autostart before the Wayland socket is fully ready. Wait a short,
# bounded time so graphical clients never start against a missing display.
waited=0
if [ -n "${WAYLAND_DISPLAY:-}" ]; then
  SOCKET_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  while [ ! -S "$SOCKET_DIR/$WAYLAND_DISPLAY" ] && [ "$waited" -lt 20 ]; do
    sleep 0.5
    waited=$((waited + 1))
  done
fi

# Calm, high-contrast dark slate background (#0b1120). No animation, no photos.
swaybg -c '#0b1120' >/dev/null 2>&1 &

# -----------------------------------------------------------------------------
# Shell supervisor
#
# The SimpleOS shell is the entire user interface. If it crashes or exits, the
# loop relaunches it immediately so the user is never dropped onto the desktop.
# The launcher is installed into the image; if an update ever removes it the loop
# waits quietly and logs once instead of spinning. Override with SIMPLEOS_SHELL_BIN.
# -----------------------------------------------------------------------------
SHELL_BIN="${SIMPLEOS_SHELL_BIN:-/usr/libexec/simpleos/simpleos-shell}"
(
  warned=0
  quick_failures=0
  while true; do
    if [ -x "$SHELL_BIN" ]; then
      started="$(date +%s)"
      "$SHELL_BIN" || true
      elapsed=$(( $(date +%s) - started ))
      # A shell that stays up for at least five seconds counts as a normal
      # session. Reset the counter so a later crash still restarts quickly.
      if [ "$elapsed" -lt 5 ]; then
        quick_failures=$(( quick_failures + 1 ))
      else
        quick_failures=0
      fi
      # Back off after repeated instant crashes so one broken build cannot spin
      # the CPU, but never stop trying to bring the interface back.
      if [ "$quick_failures" -ge 5 ]; then
        sleep 5
      else
        sleep 1
      fi
    else
      if [ "$warned" -eq 0 ]; then
        logger -t simpleos "Shell not installed yet at $SHELL_BIN; waiting"
        warned=1
      fi
      sleep 10
    fi
  done
) &

# Intentionally no tray, no notification daemon, no auto-updater pop-ups.
