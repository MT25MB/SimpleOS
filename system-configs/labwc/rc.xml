<?xml version="1.0"?>
<!--
  SimpleOS desktop configuration for labwc.

  Design goals:
    - ONE desktop, nowhere to get lost.
    - Every window opens maximized, with no titlebar for maximized windows.
    - No desktop background mouse bindings at all: no right-click menu, no
      accidental drag or resize gestures.
    - Snapping is disabled so a stray drag cannot tile a window.
    - Large, high-contrast text (Inter, 18px).

  Cursor size (48) and text scaling live in the sibling "environment" file,
  which is the mechanism labwc documents for those settings.
-->
<labwc_config>

  <core>
    <decoration>server</decoration>
    <keyboard>
      <numlock>on</numlock>
      <!-- A deliberately tiny set of predictable keyboard actions. -->
      <keybind key="A-Tab">
        <action name="NextWindow"/>
      </keybind>
      <keybind key="A-F4">
        <action name="Close"/>
      </keybind>
    </keyboard>
  </core>

  <desktops>
    <number>1</number>
    <firstdesk>1</firstdesk>
    <names>
      <name>Desktop</name>
    </names>
  </desktops>

  <theme>
    <name>Adwaita</name>
    <cornerRadius>4</cornerRadius>
    <!-- Maximized windows have no titlebar: fewer buttons, fewer mistakes. -->
    <maximizedDecoration>none</maximizedDecoration>
    <font name="Inter" size="18" weight="medium"/>
  </theme>

  <mouse>
    <!--
      Defining any mousebind disables labwc's default mousebinds. Empty bindings
      on Desktop/Root remove every click action on the background, including
      the right-click root menu.
    -->
    <context name="Desktop">
      <mousebind button="Left" action="Press"/>
      <mousebind button="Left" action="Click"/>
      <mousebind button="Left" action="DoubleClick"/>
      <mousebind button="Middle" action="Press"/>
      <mousebind button="Middle" action="Click"/>
      <mousebind button="Right" action="Press"/>
      <mousebind button="Right" action="Click"/>
    </context>
    <context name="Root">
      <mousebind button="Left" action="Press"/>
      <mousebind button="Left" action="Click"/>
      <mousebind button="Left" action="DoubleClick"/>
      <mousebind button="Middle" action="Press"/>
      <mousebind button="Middle" action="Click"/>
      <mousebind button="Right" action="Press"/>
      <mousebind button="Right" action="Click"/>
    </context>
  </mouse>

  <snapping>
    <!-- Zero thresholds disable edge/corner snapping and accidental tiling. -->
    <range>
      <inner>0</inner>
      <outer>0</outer>
    </range>
    <cornerRange>0</cornerRange>
    <overlay>
      <enabled>no</enabled>
    </overlay>
  </snapping>

  <windowRules>
    <!-- Every window, including dialogs, opens maximized. -->
    <windowRule identifier="*">
      <action name="Maximize"/>
    </windowRule>
  </windowRules>

</labwc_config>
